#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled bind port screen_enabled
    config_load axisbridge
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0
    config_get bind main bind '0.0.0.0'
    config_get port main port '8080'
    config_get_bool screen_enabled main screen_enabled 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/share/axisbridge/router_run.py --host "$bind" --port "$port"
    [ "$screen_enabled" -eq 1 ] && procd_append_param command --screen
    procd_set_param env PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/axisbridge
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger axisbridge
}
